{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Sid": "PullTheT5TrainerImage",
   "Effect": "Allow",
   "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"],
   "Resource": ["arn:aws:ecr:eu-central-1:558069890522:repository/medzen-trainer-omniasr"]
  },
  {
   "Sid": "SageMakerTrainingLogs",
   "Effect": "Allow",
   "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
   "Resource": ["arn:aws:logs:eu-central-1:558069890522:log-group:/aws/sagemaker/TrainingJobs*"]
  },
  {
   "Sid": "VpcModeNetworkInterfaces",
   "Effect": "Allow",
   "Action": ["ec2:CreateNetworkInterface", "ec2:CreateNetworkInterfacePermission",
              "ec2:DeleteNetworkInterface", "ec2:DeleteNetworkInterfacePermission",
              "ec2:DescribeNetworkInterfaces", "ec2:DescribeVpcs",
              "ec2:DescribeDhcpOptions", "ec2:DescribeSubnets", "ec2:DescribeSecurityGroups"],
   "Resource": ["*"]
  },
  {
   "Sid": "T5JobPrefixReadWrite",
   "Effect": "Allow",
   "Action": ["s3:GetObject", "s3:PutObject"],
   "Resource": ["arn:aws:s3:::medzen-speech/research/b5-training/*"]
  },
  {
   "Sid": "T5JobPrefixList",
   "Effect": "Allow",
   "Action": ["s3:ListBucket"],
   "Resource": ["arn:aws:s3:::medzen-speech"],
   "Condition": {"StringLike": {"s3:prefix": ["research/b5-training/*"]}}
  }
 ]
}
