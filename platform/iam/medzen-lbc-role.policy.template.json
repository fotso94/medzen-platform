{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDiscoveryInExactRegion",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAccountAttributes",
        "ec2:DescribeAddresses",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeInstances",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeTags",
        "ec2:DescribeVpcs",
        "ec2:GetSecurityGroupsForVpc",
        "elasticloadbalancing:DescribeListenerAttributes",
        "elasticloadbalancing:DescribeListeners",
        "elasticloadbalancing:DescribeLoadBalancerAttributes",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeRules",
        "elasticloadbalancing:DescribeTags",
        "elasticloadbalancing:DescribeTargetGroupAttributes",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "CreateOnlyInternalAlbWithExactBoundary",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:CreateLoadBalancer",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "aws:RequestTag/elbv2.k8s.aws/cluster": "medzen-speech",
          "aws:RequestTag/Project": "medzen-speech",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Stage": "B6.6",
          "aws:RequestTag/Workstream": "integration-window",
          "aws:RequestTag/BudgetRegistry": "COST-REGISTRY-2026-003",
          "elasticloadbalancing:Scheme": "internal"
        },
        "ForAllValues:StringEquals": {
          "elasticloadbalancing:SecurityGroup": ["${alb_security_group_id}"],
          "elasticloadbalancing:Subnet": [
            "subnet-00232b25bc1ac407a",
            "subnet-05029419c6c61a536",
            "subnet-01fb2fc3f56bce55e"
          ]
        },
        "Null": {
          "elasticloadbalancing:SecurityGroup": "false",
          "elasticloadbalancing:Subnet": "false"
        }
      }
    },
    {
      "Sid": "CreateOnlyClusterTaggedTargetGroups",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:CreateTargetGroup",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "aws:RequestTag/elbv2.k8s.aws/cluster": "medzen-speech",
          "aws:RequestTag/Project": "medzen-speech",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Stage": "B6.6",
          "aws:RequestTag/Workstream": "integration-window",
          "aws:RequestTag/BudgetRegistry": "COST-REGISTRY-2026-003"
        }
      }
    },
    {
      "Sid": "CreateAndManageExactB6ListenersAndRules",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:CreateRule",
        "elasticloadbalancing:DeleteListener",
        "elasticloadbalancing:DeleteRule",
        "elasticloadbalancing:ModifyListener",
        "elasticloadbalancing:ModifyRule",
        "elasticloadbalancing:SetRulePriorities"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:eu-central-1:558069890522:listener/app/medzen-b6-*/*/*",
        "arn:aws:elasticloadbalancing:eu-central-1:558069890522:listener-rule/app/medzen-b6-*/*/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "TagOnlyExactB6Resources",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:RemoveTags"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:eu-central-1:558069890522:loadbalancer/app/medzen-b6-*/*",
        "arn:aws:elasticloadbalancing:eu-central-1:558069890522:targetgroup/k8s-medzen-*/*",
        "arn:aws:elasticloadbalancing:eu-central-1:558069890522:listener/app/medzen-b6-*/*/*",
        "arn:aws:elasticloadbalancing:eu-central-1:558069890522:listener-rule/app/medzen-b6-*/*/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "elbv2.k8s.aws/cluster",
            "ingress.k8s.aws/stack",
            "ingress.k8s.aws/resource",
            "Project",
            "Environment",
            "Stage",
            "Workstream",
            "BudgetRegistry"
          ]
        }
      }
    },
    {
      "Sid": "ManageOnlyClusterTaggedLoadBalancersAndTargetGroups",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:ModifyTargetGroup",
        "elasticloadbalancing:ModifyTargetGroupAttributes"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:eu-central-1:558069890522:loadbalancer/app/medzen-b6-*/*",
        "arn:aws:elasticloadbalancing:eu-central-1:558069890522:targetgroup/k8s-medzen-*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "aws:ResourceTag/elbv2.k8s.aws/cluster": "medzen-speech"
        }
      }
    },
    {
      "Sid": "KeepExactAlbSecurityGroup",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:SetSecurityGroups",
      "Resource": "arn:aws:elasticloadbalancing:eu-central-1:558069890522:loadbalancer/app/medzen-b6-*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "aws:ResourceTag/elbv2.k8s.aws/cluster": "medzen-speech"
        },
        "ForAllValues:StringEquals": {
          "elasticloadbalancing:SecurityGroup": ["${alb_security_group_id}"]
        },
        "Null": {
          "elasticloadbalancing:SecurityGroup": "false"
        }
      }
    },
    {
      "Sid": "KeepExactAlbSubnets",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:SetSubnets",
      "Resource": "arn:aws:elasticloadbalancing:eu-central-1:558069890522:loadbalancer/app/medzen-b6-*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "aws:ResourceTag/elbv2.k8s.aws/cluster": "medzen-speech"
        },
        "ForAllValues:StringEquals": {
          "elasticloadbalancing:Subnet": [
            "subnet-00232b25bc1ac407a",
            "subnet-05029419c6c61a536",
            "subnet-01fb2fc3f56bce55e"
          ]
        },
        "Null": {
          "elasticloadbalancing:Subnet": "false"
        }
      }
    },
    {
      "Sid": "RegisterOnlyExactB6TargetGroups",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:RegisterTargets",
        "elasticloadbalancing:DeregisterTargets"
      ],
      "Resource": "arn:aws:elasticloadbalancing:eu-central-1:558069890522:targetgroup/k8s-medzen-*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "aws:ResourceTag/elbv2.k8s.aws/cluster": "medzen-speech"
        }
      }
    }
  ]
}
