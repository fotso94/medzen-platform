{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::medzen-speech/raw/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::medzen-speech"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::medzen-speech/curated/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::medzen-speech"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "curated/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::medzen-speech/eval/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::medzen-speech"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "eval/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::medzen-speech/candidates/*"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::medzen-speech/eval/*"
      ],
      "Sid": "A3EvalSetsAreWriteDeniedToTrainingRole"
    },
    {
      "Effect": "Deny",
      "Action": [
        "secretsmanager:*"
      ],
      "Resource": [
        "*"
      ],
      "Sid": "TrainingNeverHoldsProductionCredentials"
    },
    {
      "Effect": "Deny",
      "Action": [
        "bedrock:*"
      ],
      "Resource": [
        "*"
      ],
      "Sid": "TrainingPlaneHasNoProductionModelAccess"
    }
  ]
}
