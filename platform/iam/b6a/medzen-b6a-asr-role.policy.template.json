{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExactB6ANamespaceOnly",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalTag/kubernetes-namespace": "medzen"
        }
      }
    },
    {
      "Sid": "ExactB6AServiceAccountOnly",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalTag/kubernetes-service-account": "asr-runtime-b6a"
        }
      }
    },
    {
      "Sid": "ListExactB6AArtifactPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::medzen-speech",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "b6a/asr/v0/5adf77568813513bc3697a1501ba354c04c7b93ea374fc5407cf4f6402f7431e",
            "b6a/asr/v0/5adf77568813513bc3697a1501ba354c04c7b93ea374fc5407cf4f6402f7431e/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadExactB6AArtifactPrefix",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::medzen-speech/b6a/asr/v0/5adf77568813513bc3697a1501ba354c04c7b93ea374fc5407cf4f6402f7431e/*"
    },
    {
      "Sid": "DecryptB6AObjectsThroughS3Only",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:DescribeKey"],
      "Resource": "arn:aws:kms:eu-central-1:558069890522:key/9c336116-c648-4548-95c6-1b926478ae57",
      "Condition": {
        "StringEquals": {"kms:ViaService": "s3.eu-central-1.amazonaws.com"},
        "StringLike": {
          "kms:EncryptionContext:aws:s3:arn": [
            "arn:aws:s3:::medzen-speech",
            "arn:aws:s3:::medzen-speech/b6a/asr/v0/5adf77568813513bc3697a1501ba354c04c7b93ea374fc5407cf4f6402f7431e/*"
          ]
        }
      }
    },
    {
      "Sid": "NoArtifactMutation",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:RestoreObject"
      ],
      "Resource": "arn:aws:s3:::medzen-speech/*"
    },
    {
      "Sid": "NeverReadApprovedModels",
      "Effect": "Deny",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::medzen-speech/approved/asr/*"
    }
  ]
}
