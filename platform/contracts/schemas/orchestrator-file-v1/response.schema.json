{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medzen.orchestrator.file.v1.response",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "session_id", "language", "transcript", "reply", "model_versions", "latency_ms"],
  "properties": {
    "request_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verbatim", "normalized", "normalization_version"],
      "properties": {
        "verbatim": {"type": "string", "minLength": 1},
        "normalized": {"type": "string", "minLength": 1},
        "normalization_version": {"type": "string", "minLength": 1}
      }
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "citations", "citation_binding_sha256", "audio_url", "tts_backend"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "citations": {
          "type": "array",
          "maxItems": 5,
          "items": {"$ref": "#/$defs/citation"}
        },
        "citation_binding_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "audio_url": {"type": "null"},
        "tts_backend": {"const": "text_only"}
      }
    },
    "model_versions": {"$ref": "#/$defs/model_versions"},
    "latency_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "asr", "rag", "llm", "tts"],
      "properties": {
        "total": {"type": "number", "minimum": 0},
        "asr": {"type": "number", "minimum": 0},
        "rag": {"type": "number", "minimum": 0},
        "llm": {"type": "number", "minimum": 0},
        "tts": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "document_id", "title", "source_uri", "section", "content_sha256", "excerpt", "score"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "document_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "excerpt": {"type": "string", "minLength": 1},
        "score": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "model_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asr", "registry_snapshot", "llm", "rag", "tts"],
      "properties": {
        "asr": {"const": "v0-local-synthetic-asr"},
        "registry_snapshot": {"pattern": "^b6-test:[0-9a-f]{64}$"},
        "llm": {"enum": ["fake-bedrock-local-v1", null]},
        "rag": {"enum": ["sha256:6dc2a9217b44a8cd9523ee051f19a7e20d1cab447ad0029a42796c5211797160", null]},
        "tts": {"type": "null"}
      }
    }
  }
}
