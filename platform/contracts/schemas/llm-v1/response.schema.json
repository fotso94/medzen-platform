{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medzen.llm.v1.response",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "language", "reply", "policy", "provider", "model_versions", "latency_ms"],
  "properties": {
    "request_id": {"type": "string", "format": "uuid"},
    "language": {"type": "string"},
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "citations", "citation_binding_sha256"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/citation"}
        },
        "citation_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provider": {"const": "fake_bedrock"},
    "model_versions": {"$ref": "#/$defs/model_versions"},
    "latency_ms": {"type": "number", "minimum": 0}
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "document_id", "title", "source_uri", "section", "content_sha256", "excerpt", "score"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "document_id": {"type": "string"},
        "title": {"type": "string"},
        "source_uri": {"type": "string"},
        "section": {"type": "string"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "excerpt": {"type": "string"},
        "score": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "model_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asr", "registry_snapshot", "llm", "rag", "tts"],
      "properties": {
        "asr": {"type": ["string", "null"]},
        "registry_snapshot": {"type": "string"},
        "llm": {"const": "fake-bedrock-local-v1"},
        "rag": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "tts": {"type": ["string", "null"]}
      }
    }
  }
}
