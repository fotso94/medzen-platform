# omniASR trainer image (design record T4).
#
# Built on the SAME CUDA base, torch pins and omnilingual-asr commit as the
# evaluation runtime so training and evaluation share one dependency truth
# (Base v5 B10: plain Docker, env-var config, SageMaker-compatible, no host
# assumptions). Training additions are exactly: soundfile for audio decode
# in the data loader. The LoRA wrapper, licence gate and export live in
# pipeline/ and are COPYed, not pip-installed, so the image hash moves with
# the reviewed source.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04@sha256:ac55d124da4882b497f732d8dfd9a702d5447a5f29d08d56da6f64f0a1eb34bc AS trainer-builder

ARG OMNI_COMMIT=145a12a668aace6c1d0d290128c1225571fc1955
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git libsndfile1-dev \
        python3.12 python3.12-dev python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/build
RUN python3.12 -m venv /opt/venv \
    && pip install --no-cache-dir "pip==26.2"
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 \
        "torch==2.8.0" "torchaudio==2.8.0"
COPY services/asr-eval-runtime/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt "soundfile==0.13.1" \
        "boto3==1.43.58"
RUN git clone --filter=blob:none https://github.com/facebookresearch/omnilingual-asr.git omnilingual-asr \
    && git -C omnilingual-asr checkout --detach "$OMNI_COMMIT" \
    && test "$(git -C omnilingual-asr rev-parse HEAD)" = "$OMNI_COMMIT" \
    && pip install --no-cache-dir --no-deps ./omnilingual-asr

# Test stage: the torch-marked suites that skip on the engineering host run
# HERE, on the exact dependency set the job will carry. Built with
# --target trainer-test; never shipped (the final stage below does not
# inherit from it, and its pytest never reaches the runtime image).
FROM trainer-builder AS trainer-test
RUN pip install --no-cache-dir "pytest==9.1.1"
WORKDIR /opt/medzen
COPY pipeline/__init__.py pipeline/omniasr_lora.py pipeline/omniasr_export.py \
     pipeline/licence_filter.py pipeline/omniasr_train.py \
     pipeline/omniasr_data.py pipeline/train_asr.py pipeline/languages.py \
     pipeline/omniasr_distill.py pipeline/omniasr_calibrate.py \
     pipeline/omniasr_score.py \
     pipeline/sealed_eval.py \
     pipeline/normalizers.py \
     ./pipeline/
# Codex review #20 F6: the calibration verifier + launcher semantics run
# IN the image so a shipped image is proven to carry a working, non-bypassable
# verifier (the entrypoint runs it at calibration time).
COPY scripts/verify_arm2_calibration.py scripts/b5_sagemaker_job.py ./scripts/
# test stage carries BOTH the launch packet (tests validate it) and the
# execution contract (the runtime artifact); only the CONTRACT ships (below)
COPY platform/manifests/B5-UNIVERSAL-ARM2-FTCAL-SAGEMAKER-BINDINGS-2026-001.DRAFT.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H3-SAGEMAKER-BINDINGS-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-FTCAL-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-THRUBENCH-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-KDCONTROL-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H0-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H1-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H2-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H3-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H4-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-KDCONTROL-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-H0-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-H1-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-H2-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-H3-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-H4-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-KDCONTROL-EXECUTION-CONTRACT-2026-002.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-KDCONTROL-EXECUTION-CONTRACT-2026-002.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MTCAL-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MECH-MTCAL-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MECH-MTCAL-EXECUTION-CONTRACT-2026-002.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MECH-MTCAL-EXECUTION-CONTRACT-2026-003.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MECH-MTCAL-EXECUTION-CONTRACT-2026-004.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MTCAL-EXECUTION-CONTRACT-2026-002.json \
     platform/manifests/B5-GB10-11LANG-WARM-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-GB10-11LANG-FTCAL-EXECUTION-CONTRACT-2026-002.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-H3-EXECUTION-CONTRACT-2026-001.json \
     ./platform/manifests/
# the PREDECLARED frozen dev-sentinel slices (Codex #21 F4) — the in-image
# tests assert they match the packet's path/sha256/rows declaration
COPY platform/manifests/dev-sentinels/ ./platform/manifests/dev-sentinels/
COPY platform/promotion/scorer_v1.py ./promotion/scorer_v1.py
COPY tests/test_omniasr_lora.py tests/test_omniasr_train.py \
     tests/test_omniasr_distill.py tests/test_arm2_calibration.py \
     tests/test_arm2b_dual_teacher.py ./tests/
ENV PYTHONPATH=/opt/medzen
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
RUN python -m pytest tests/test_omniasr_lora.py tests/test_omniasr_train.py \
        tests/test_omniasr_distill.py tests/test_arm2_calibration.py \
        tests/test_arm2b_dual_teacher.py -q \
    && python - <<'VERIFY'
# fairseq2 contact-surface check: every name the trainer touches must
# resolve on the pinned dependency set, and the model forward signature
# must carry the (seqs, seqs_layout, targets, targets_layout) contract.
import inspect
from fairseq2.data.tokenizers.hub import load_tokenizer  # noqa: F401
from fairseq2.models.hub import load_model  # noqa: F401
from fairseq2.models.wav2vec2.asr import Wav2Vec2AsrModel
from fairseq2.nn import BatchLayout  # noqa: F401
parameters = list(inspect.signature(Wav2Vec2AsrModel.forward).parameters)
assert parameters[1:5] == ["seqs", "seqs_layout", "targets", "targets_layout"], parameters
print("fairseq2 contact surface: OK", parameters[1:5])
VERIFY

# Shipped venv keeps the original no-pip property; only trainer-test has pip.
FROM trainer-builder AS trainer-venv
RUN python -m pip uninstall -y pip setuptools wheel

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04@sha256:ac55d124da4882b497f732d8dfd9a702d5447a5f29d08d56da6f64f0a1eb34bc

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
# The upgrade must run in THIS stage: the shipped OS packages live here, and
# a cached builder layer must never decide what CVE state ships (the first
# T5 push carried six critical CVEs whose noble fixes existed — all because
# the apt layers were Docker-cache stale).
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends libsndfile1 python3.12 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=trainer-venv /opt/venv /opt/venv
COPY pipeline/omniasr_lora.py pipeline/omniasr_export.py \
     pipeline/licence_filter.py pipeline/omniasr_train.py \
     pipeline/omniasr_data.py pipeline/train_asr.py pipeline/languages.py \
     pipeline/omniasr_distill.py pipeline/omniasr_calibrate.py \
     pipeline/omniasr_score.py \
     pipeline/sealed_eval.py \
     pipeline/normalizers.py \
     /opt/medzen/pipeline/
COPY pipeline/__init__.py /opt/medzen/pipeline/__init__.py
# Codex review #20 F3/F6: the calibration entrypoint (pipeline.omniasr_calibrate,
# the packet's ContainerArguments) runs the canonical verifier in-image after
# training, so both the verifier and the packet it checks against must ship.
COPY scripts/verify_arm2_calibration.py /opt/medzen/scripts/verify_arm2_calibration.py
# Codex #22 blocker 2: the image bakes the SELF-REFERENCE-FREE execution
# contract, NEVER the launch packet (the packet binds this image's digest and
# so cannot exist inside it). The launcher injects the contract path + sha;
# the wrapper refuses a contract whose bytes do not hash to the declaration.
COPY platform/manifests/B5-UNIVERSAL-ARM2-FTCAL-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-THRUBENCH-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-KDCONTROL-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H0-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H1-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H2-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H3-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-H4-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-KDCONTROL-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-H0-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-H1-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-H2-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-H3-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-H4-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2-KDCONTROL-EXECUTION-CONTRACT-2026-002.json \
     platform/manifests/B5-UNIVERSAL-ARM2-MECH-KDCONTROL-EXECUTION-CONTRACT-2026-002.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MTCAL-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MECH-MTCAL-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MECH-MTCAL-EXECUTION-CONTRACT-2026-002.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MECH-MTCAL-EXECUTION-CONTRACT-2026-003.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MECH-MTCAL-EXECUTION-CONTRACT-2026-004.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-MTCAL-EXECUTION-CONTRACT-2026-002.json \
     platform/manifests/B5-GB10-11LANG-WARM-EXECUTION-CONTRACT-2026-001.json \
     platform/manifests/B5-GB10-11LANG-FTCAL-EXECUTION-CONTRACT-2026-002.json \
     platform/manifests/B5-UNIVERSAL-ARM2B-H3-EXECUTION-CONTRACT-2026-001.json \
     /opt/medzen/platform/manifests/
# the PREDECLARED frozen dev-sentinel slices (Codex #21 F4): the calibration
# wrapper refuses to score any slice whose sha differs from the packet's
# declaration, so the exact reviewed bytes must ship
COPY platform/manifests/dev-sentinels/ /opt/medzen/platform/manifests/dev-sentinels/
COPY platform/promotion/scorer_v1.py /opt/medzen/promotion/scorer_v1.py
# The SAME fairseq2 asset cards the evaluation runtime ships — model and
# tokenizer identity resolve identically in training and evaluation
# (r3 died on ModelNotKnownError because the trainer image lacked them).
COPY services/asr-eval-runtime/assets /opt/medzen/assets
ENV FAIRSEQ2_ASSET_DIR=/opt/medzen/assets
ENV PYTHONPATH=/opt/medzen
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Root inside the container, deliberately: SageMaker training mounts
# /opt/ml/model and /opt/ml/checkpoints root-owned into a managed
# single-tenant VM (T5-r2 died on EACCES writing provenance as uid 10001).
# The non-root posture belongs to the EKS serving images, not here.
ENTRYPOINT ["/opt/venv/bin/python"]
